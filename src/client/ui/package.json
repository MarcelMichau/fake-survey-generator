{
	"name": "fake-survey-generator-ui",
	"private": true,
	"version": "5.5.6",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"generate:api": "node ../../../tools/api-contracts/generate.mjs",
		"check:api": "node ../../../tools/api-contracts/generate.mjs --check",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"preview": "vite preview",
		"test": "vitest",
		"test:browser:install": "playwright install chromium",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@auth0/auth0-react": "^2.28.2",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/react-fontawesome": "^3.5.0",
		"@tanstack/react-query": "^5.104.1",
		"openapi-fetch": "^0.17.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-loading-skeleton": "^3.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"playwright": "^1.64.0",
		"postcss": "^8.5.29",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"vitest-browser-react": "^2.3.0"
	},
	"allowScripts": {
		"browser-tabs-lock@1.3.0": true
	}
